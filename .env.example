# Kopieer dit bestand naar .env en vul je eigen API keys in
# cp .env.example .env

# OpenAI API key — voor verhaal en stijl generatie
OPENAI_API_KEY=sk-...

# Replicate API token — voor SDXL afbeeldingen
REPLICATE_API_TOKEN=r8_...

# Model instellingen (optioneel, defaults zijn ingesteld in pipeline.py)
OPENAI_MODEL=gpt-4o-mini
REPLICATE_MODEL=stability-ai/sdxl:39ed52f2319f9c539...
IMAGE_WIDTH=1200
IMAGE_HEIGHT=1700
